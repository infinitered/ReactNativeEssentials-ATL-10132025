
#!/bin/bash

# Exit on error
set -e

if [ $# -ne 1 ]; then
    echo "Usage: ./scripts/skipTo <chapter_number>"
    exit 1
fi

CHAPTER_NUM=$1
APP_DIR="src"
CHAPTER_DIR="solutions/chapter${CHAPTER_NUM}"

# Check if chapter directory exists
if [ ! -d "$CHAPTER_DIR" ]; then
    echo "Error: Chapter ${CHAPTER_NUM} directory not found"
    exit 1
fi

# Prompt for confirmation
read -p "Are you sure? This will overwrite everything in your src folder (y/n) " -n 1 -r
echo
if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    echo "Operation cancelled"
    exit 1
fi

# Remove existing src directory contents, but preserve shared imports path adjustments are handled via tsconfig
find "$APP_DIR" -mindepth 1 -maxdepth 1 -not -name "shared" -exec rm -rf {} +

# Copy chapter contents to src directory while preserving shared at project root
cp -r "$CHAPTER_DIR"/* "$APP_DIR/"

# Find and replace import paths for Expo project structure
find "$APP_DIR" -type f -name "*.ts" -o -name "*.tsx" | while read -r file; do
    # Replace '../../../shared' with '../../shared' (if solutions use shared folder)
    sed -i '' 's/\.\.\/\.\.\/\.\.\/shared/\.\.\/\.\.\/shared/g' "$file"
    # Update any other path adjustments as needed for Expo structure
done

echo "Successfully skipped to chapter ${CHAPTER_NUM}"
